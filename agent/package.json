{
  "name": "edusim-agent",
  "version": "1.0.0",
  "description": "EduSim Local Hardware Agent — bridges browser IDE to arduino-cli and serial ports",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "pkg server.js --targets node18-win-x64 --output dist/EduSimAgent"
  },
  "pkg": {
    "assets": [
      "bin/**/*"
    ]
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "ws": "^8.16.0",
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=16"
  }
}
